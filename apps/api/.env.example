# Auth0 custom API values. The issuer must be the exact HTTPS tenant issuer.
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://api.creator-agent.example

# Server-only secret. Never expose this value through a VITE_* variable.
DATABASE_URL=postgres://creator_agent:local-development-only@127.0.0.1:5432/creator_agent

API_PORT=4320
API_HOST=127.0.0.1
API_ALLOWED_ORIGIN=http://127.0.0.1:4173

# Optional free GitHub App integration. Configure all values together. The private key,
# client secret, and webhook secret stay server-side and must never use a VITE_* prefix.
# Use API_HOST=0.0.0.0 and public HTTPS URLs only in a deployed environment.
# GITHUB_APP_CLIENT_ID=Iv1.your_client_id
# GITHUB_APP_CLIENT_SECRET=your_client_secret
# GITHUB_APP_CALLBACK_URL=https://api.example.com/v1/github/callback
# GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# GITHUB_APP_WEBHOOK_SECRET=long_random_webhook_secret
# GITHUB_APP_SLUG=creator-agent-content

# Optional private S3-compatible storage. Without these values, upload routes fail closed.
OBJECT_STORAGE_BUCKET=creator-agent-private
OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
# OBJECT_STORAGE_ACCESS_KEY_ID=local-access-key
# OBJECT_STORAGE_SECRET_ACCESS_KEY=local-secret-key
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Set false only for disposable local S3-compatible storage without SSE support.
# OBJECT_STORAGE_REQUIRE_SSE_HEADER=false

# Optional private ClamAV daemon. The quarantine worker refuses to run without it.
# Keep port 3310 on a private network; clamd TCP has no transport authentication.
MALWARE_SCANNER_HOST=127.0.0.1
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT_MS=120000
