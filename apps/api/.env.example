# Auth0 custom API values. The issuer must be the exact HTTPS tenant issuer.
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://api.creator-agent.example

# Server-only secret. Never expose this value through a VITE_* variable.
DATABASE_URL=postgres://creator_agent:local-development-only@127.0.0.1:5432/creator_agent

API_PORT=4320
API_ALLOWED_ORIGIN=http://127.0.0.1:4173
