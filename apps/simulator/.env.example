# Use "local" only for the zero-cost development simulator.
VITE_AUTH_MODE=auth0

# Auth0 Single Page Application settings. These values are public client configuration,
# never a client secret. Do not put Management API tokens or client secrets in Vite env files.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id

# Optional until the authenticated Creator Agent API exists.
# VITE_AUTH0_AUDIENCE=https://api.creator-agent.example
